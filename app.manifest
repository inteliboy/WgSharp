<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WgSharp.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- asInvoker: the GUI runs UNELEVATED, so launching WgSharp shows no
             UAC prompt. All privileged work (adapter/driver, routes, DNS,
             firewall) happens in the WgSharpSvc background service
             (LocalSystem), which the GUI drives over a named pipe whose
             control commands are restricted to members of the Administrators
             group (checked against the client's LINKED token, so an
             unelevated admin passes without a prompt; see PipeClientAuth).
             The only elevation left is a ONE-TIME "runas" self-launch with
             the elevated-setup switch to register/start the service (plus
             firewall pre-authorization) on first use. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
